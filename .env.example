# Local / Dashboard overrides. Core wiring is in render.yaml.

# Required on first Blueprint apply. Both must start with sk-
# Generate: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-replace-me
LITELLM_SALT_KEY=sk-replace-me-and-never-rotate

# Optional. You can also paste provider keys in the Admin UI after login.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Wired by the Blueprint on Render. For local compose, point at Postgres.
# DATABASE_URL=postgresql://litellm:replace-me@localhost:5432/litellm

# Blueprint defaults (do not change unless you know why):
# PORT=4000
# HOST=0.0.0.0
# NUM_WORKERS=1
# LITELLM_MODE=PRODUCTION
# STORE_MODEL_IN_DB=True
